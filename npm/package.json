{
  "name": "@tty-pt/lemma",
  "version": "1.4.0",
  "type": "module",
  "description": "Universal Node.js and Browser bindings for liblemma Lexical Search & Unicode Accent Folding",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "include",
    "assets",
    "*.pc",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:native": "mkdir -p build/Release && gcc -O3 -fPIC -shared -I/usr/include/node -I../include -I../../libcorm/include native/lemma_napi.c -L../lib -L../../libcorm/lib -Wl,-rpath,\\$ORIGIN/../../../lib:\\$ORIGIN/../../../../libcorm/lib -L/usr/lib -llemma -lcorm -o build/Release/lemma_node.node",
    "build:wasm": "make -C .. wasm",
    "build": "npm run build:native && npm run build:wasm",
    "test": "node --test tests/lemma.test.mjs"
  },
  "peerDependencies": {
    "@tty-pt/corm": ">=2.4.0",
    "@tty-pt/stele": ">=1.7.0"
  },
  "devDependencies": {
    "@tty-pt/corm": "^2.4.0",
    "@tty-pt/stele": "^1.7.0"
  },
  "keywords": [
    "lemma",
    "liblemma",
    "accent-folding",
    "lexical",
    "stemming",
    "search",
    "bm25"
  ],
  "author": "Paulo Quirino",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tty-pt/liblemma.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/tty-pt/liblemma/tree/main/npm#readme",
  "bugs": {
    "url": "https://github.com/tty-pt/liblemma/issues"
  }
}
